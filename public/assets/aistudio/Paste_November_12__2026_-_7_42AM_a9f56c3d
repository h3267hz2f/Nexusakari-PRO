### 解决方案二：真正接通 Rust WAMP v1.0 WebSocket（支持自签名证书 + Basic Auth + `<5ms` 事件驱动秒抢）

#### 问题根因
1. `lcu_connector.rs` 中的 `tokio_tungstenite::connect_async(&ws_url)` 未携带 `Authorization: Basic ...` 请求头，且未跳过 LCU 的 `riotgames.pem` 自签名证书校验，必然握手失败。
2. `main.rs` 从未调用 `spawn_wamp_subscriber_loop`，而是靠 `1500ms` 的 HTTP 轮询。

#### 修改步骤 1：在 `src-tauri/Cargo.toml` 中开启 TLS 自定义连接器支持
在 `src-tauri/Cargo.toml` 的 `[dependencies]` 中补充 `http` 与 `rustls`（或使用 `native-tls`）：

```toml
tokio-tungstenite = { version = "0.24", features = ["rustls-tls-webpki-roots"] }
rustls = { version = "0.23", default-features = false, features = ["std", "tls12", "ring"] }
http = "1.1"
```

#### 修改步骤 2：重写 `src-tauri/src/lcu_connector.rs` 的 `spawn_wamp_subscriber_loop`
配置自定义 `NoCertVerifier` 与 `Authorization` 握手请求头：

```rust
use tokio_tungstenite::{
    connect_async_tls_with_config,
    tungstenite::{client::IntoClientRequest, http::HeaderValue, Message},
    Connector,
};

#[derive(Debug)]
struct InsecureLcuCertVerifier;

impl rustls::client::danger::ServerCertVerifier for InsecureLcuCertVerifier {
    fn verify_server_cert(
        &self,
        _end_entity: &rustls::pki_types::CertificateDer<'_>,
        _intermediates: &[rustls::pki_types::CertificateDer<'_>],
        _server_name: &rustls::pki_types::ServerName<'_>,
        _ocsp_response: &[u8],
        _now: rustls::pki_types::UnixTime,
    ) -> Result<rustls::client::danger::ServerCertVerified, rustls::Error> {
        Ok(rustls::client::danger::ServerCertVerified::assertion())
    }

    fn verify_tls12_signature(
        &self,
        _message: &[u8],
        _cert: &rustls::pki_types::CertificateDer<'_>,
        _dss: &rustls::DigitallySignedStruct,
    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
        Ok(rustls::client::danger::HandshakeSignatureValid::assertion())
    }

    fn verify_tls13_signature(
        &self,
        _message: &[u8],
        _cert: &rustls::pki_types::CertificateDer<'_>,
        _dss: &rustls::DigitallySignedStruct,
    ) -> Result<rustls::client::danger::HandshakeSignatureValid, rustls::Error> {
        Ok(rustls::client::danger::HandshakeSignatureValid::assertion())
    }

    fn supported_verify_schemes(&self) -> Vec<rustls::SignatureScheme> {
        rustls::crypto::ring::default_provider()
            .signature_verification_algorithms
            .supported_schemes()
    }
}

pub fn spawn_wamp_subscriber_loop(
    creds: LcuRcuCredentials,
    ring_buffer: Arc<IpcRingBuffer>,
    event_tx: tokio::sync::broadcast::Sender<WampEventPayload>,
    mut shutdown_rx: watch::Receiver<bool>,
) -> tokio::task::JoinHandle<()> {
    tokio::spawn(async move {
        let ws_url = format!("wss://127.0.0.1:{}/", creds.lcu_port);
        let filter = WampPrefixFilter::default();

        // 1. 构造携带 Basic Auth 的 WebSocket 握手请求
        let mut request = match ws_url.into_client_request() {
            Ok(req) => req,
            Err(_) => return,
        };
        if let Ok(auth_val) = HeaderValue::from_str(&format_basic_auth_header(&creds.lcu_auth_token)) {
            request.headers_mut().insert("Authorization", auth_val);
        }

        // 2. 构造跳过 LCU 自签名证书校验的 Rustls Connector
        let tls_config = rustls::ClientConfig::builder_with_provider(
            rustls::crypto::ring::default_provider().into(),
        )
        .with_safe_default_protocol_versions()
        .unwrap()
        .dangerous()
        .with_custom_certificate_verifier(Arc::new(InsecureLcuCertVerifier))
        .with_no_client_auth();

        let connector = Connector::Rustls(Arc::new(tls_config));

        if let Ok((mut ws_stream, _)) =
            connect_async_tls_with_config(request, None, false, Some(connector)).await
        {
            let _ = ws_stream
                .send(Message::Text("[5, \"OnJsonApiEvent\"]".into()))
                .await;

            ring_buffer
                .push(IpcEnvelope {
                    id: format!("wamp-sub-{}", chrono::Utc::now().timestamp_micros()),
                    timestamp: chrono::Utc::now().format("%H:%M:%S%.3f").to_string(),
                    channel: "LCU_WAMP".to_string(),
                    method: "SUBSCRIBE".to_string(),
                    endpoint: "[5, \"OnJsonApiEvent\"]".to_string(),
                    status: 101,
                    duration_ms: 1.2,
                    payload_summary: "WAMP v1.0 TLS+BasicAuth connected with Prefix Filter".to_string(),
                })
                .await;

            loop {
                tokio::select! {
                    msg_opt = ws_stream.next() => {
                        match msg_opt {
                            Some(Ok(msg)) if msg.is_text() => {
                                if let Ok(raw_text) = msg.into_text() {
                                    if let Some(ev) = parse_wamp_event_frame(&raw_text, &filter) {
                                        ring_buffer
                                            .push(IpcEnvelope {
                                                id: format!("wamp-ev-{}", chrono::Utc::now().timestamp_micros()),
                                                timestamp: chrono::Utc::now().format("%H:%M:%S%.3f").to_string(),
                                                channel: "LCU_WAMP".to_string(),
                                                method: ev.event_type.clone(),
                                                endpoint: ev.uri.clone(),
                                                status: 200,
                                                duration_ms: 0.15,
                                                payload_summary: format!("WAMP delta on {}", ev.uri),
                                            })
                                            .await;
                                        let _ = event_tx.send(ev);
                                    }
                                }
                            }
                            Some(Err(_)) | None => break,
                            _ => {}
                        }
                    }
                    _ = shutdown_rx.changed() => {
                        if *shutdown_rx.borrow() {
                            break;
                        }
                    }
                }
            }
        }
    })
}
```

#### 修改步骤 3：在 `src-tauri/src/main.rs` 的 `setup` 中挂载 WAMP 实时事件触发器
当 WAMP 收到 `/lol-champ-select/v1/session` 或 `/lol-gameflow/v1/gameflow-phase` 推送帧时，**在 `<5ms` 内立即触发**秒抢与防误 Ban 状态机，将 1500ms 轮询仅作为兜底：

```rust
// 在 src-tauri/src/main.rs 的 .setup(...) 内部：
let (wamp_tx, mut wamp_rx) = tokio::sync::broadcast::channel(128);
let st_wamp_runner = Arc::clone(&st);

// 监听 WAMP 推送流，实现真正的 <5ms 毫秒级响应
tauri::async_runtime::spawn(async move {
    while let Ok(ev) = wamp_rx.recv().await {
        if ev.uri == "/lol-champ-select/v1/session" {
            let _ = st_wamp_runner.execute_champ_select_tick().await;
        } else if ev.uri == "/lol-gameflow/v1/gameflow-phase" {
            if let Some(phase_str) = ev.data.as_str() {
                let _ = st_wamp_runner.run_lifecycle_automation(phase_str).await;
            }
        } else if ev.uri == "/lol-matchmaking/v1/ready-check" {
            let _ = st_wamp_runner.run_lifecycle_automation("ReadyCheck").await;
        }
    }
});

// 当检测到 LCU 进程凭证变更时，自动启动/重启 WAMP 订阅协程
let mut active_wamp_port: u16 = 0;
let mut wamp_kill_tx: Option<tokio::sync::watch::Sender<bool>> = None;
// 在主循环中：
if let Some(ref creds) = creds_opt {
    if creds.lcu_port != active_wamp_port {
        if let Some(old_tx) = wamp_kill_tx.take() {
            let _ = old_tx.send(true);
        }
        let (kill_tx, kill_rx) = tokio::sync::watch::channel(false);
        wamp_kill_tx = Some(kill_tx);
        active_wamp_port = creds.lcu_port;
        nexus_akari_pro_lib::lcu_connector::spawn_wamp_subscriber_loop(
            creds.clone(),
            Arc::clone(&st.ring_buffer),
            wamp_tx.clone(),
            kill_rx,
        );
    }
}
